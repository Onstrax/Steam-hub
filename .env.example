# Clave de la API de Steam Web API.
# Obtenerla en: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=PEGA_TU_API_KEY_AQUI

# SteamID64 de tu perfil (solo números, visible en tu perfil de Steam).
# Ejemplo: https://steamcommunity.com/profiles/76561190000000000
STEAM_ID=76561190000000000

# Puerto del host donde publicar la app (solo aplica con Docker Compose).
HOST_PORT=3311
